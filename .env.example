# HeadHunter application token. Anonymous requests may be interrupted by captcha.
HH_ACCESS_TOKEN=
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Required contact information for the HH-User-Agent header.
HH_USER_AGENT=SkillScope/0.1 (your-email@example.com)

# Request behaviour.
HH_REQUEST_TIMEOUT_SECONDS=20
HH_MAX_RETRIES=4
